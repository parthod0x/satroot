{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/satroot1.schema.json",
  "title": "SATROOT-1 Record",
  "type": "object",
  "required": ["protocol", "version", "action", "root_id", "sequence"],
  "properties": {
    "protocol": {"const": "SATROOT-1"},
    "version": {"const": "0.1"},
    "action": {"enum": ["genesis", "mint", "transfer", "burn"]},
    "root_id": {"type": "string", "pattern": "^[a-fA-F0-9]{64}:[0-9]+$"},
    "sequence": {"type": "integer", "minimum": 0},
    "prev_event_id": {"type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$"},
    "event_id": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"},
    "profile": {"type": "string", "pattern": "^[A-Z0-9-]{1,32}$"},
    "profile_mode": {"type": "string", "pattern": "^[a-z0-9-]{1,32}$"},
    "reference_unit": {"type": "string", "pattern": "^[A-Z0-9]{2,16}$"},
    "redemption": {"type": "string", "enum": ["none"]},
    "reserve_model": {"type": "string", "enum": ["none"]},
    "service_scope": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "billing_unit": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "consumption_model": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "document_type": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "reference_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "issuer_entity": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "counterparty_entity": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "settlement_unit": {"type": "string", "pattern": "^[A-Z0-9]{2,16}$"},
    "identity_type": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "controller_entity": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "authority_scope": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "license_type": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "licensor_entity": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "licensee_entity": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "usage_scope": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "intended_use": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9]{1,16}$"},
    "name": {"type": "string", "minLength": 1},
    "decimals": {"type": "integer", "minimum": 0, "maximum": 18},
    "max_supply": {"type": "string", "pattern": "^[0-9]+$"},
    "mint_authority": {"type": "string", "minLength": 1},
    "transfer_model": {"enum": ["account-ledger"]},
    "initial_balances": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9]+$"}
    },
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "amount": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "signer": {"type": "string", "minLength": 1},
    "signature": {"type": "string", "minLength": 1},
    "nonce": {"type": "string"},
    "rules_hash": {"type": "string"},
    "state_hash": {"type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "SATROOT-STABLE-1"}}},
      "then": {
        "properties": {
          "profile_mode": {"const": "reference-only"}
        },
        "required": ["profile_mode", "reference_unit", "redemption", "reserve_model", "intended_use"]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "SATROOT-MACHINE-1"}}},
      "then": {
        "properties": {
          "profile_mode": {"const": "prepaid-credit"}
        },
        "required": ["profile_mode", "service_scope", "billing_unit", "consumption_model", "intended_use"]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "SATROOT-RECEIPT-1"}}},
      "then": {
        "properties": {
          "profile_mode": {"const": "single-receipt"}
        },
        "required": ["profile_mode", "document_type", "reference_id", "issuer_entity", "counterparty_entity", "settlement_unit", "intended_use"]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "SATROOT-IDENTITY-1"}}},
      "then": {
        "properties": {
          "profile_mode": {"const": "single-identity"}
        },
        "required": ["profile_mode", "identity_type", "subject_id", "controller_entity", "authority_scope", "intended_use"]
      }
    },
    {
      "if": {"properties": {"profile": {"const": "SATROOT-LICENSE-1"}}},
      "then": {
        "properties": {
          "profile_mode": {"const": "single-license"}
        },
        "required": ["profile_mode", "license_type", "asset_id", "licensor_entity", "licensee_entity", "usage_scope", "intended_use"]
      }
    },
    {
      "if": {"properties": {"action": {"const": "genesis"}}},
      "then": {
        "required": ["symbol", "name", "decimals", "max_supply", "mint_authority", "transfer_model", "initial_balances", "rules_hash", "nonce"],
        "not": {"required": ["prev_event_id"]}
      }
    },
    {
      "if": {"properties": {"action": {"const": "mint"}}},
      "then": {"required": ["prev_event_id", "to", "amount", "signer", "signature"]}
    },
    {
      "if": {"properties": {"action": {"const": "transfer"}}},
      "then": {"required": ["prev_event_id", "from", "to", "amount", "signer", "signature"]}
    },
    {
      "if": {"properties": {"action": {"const": "burn"}}},
      "then": {"required": ["prev_event_id", "from", "amount", "signer", "signature"]}
    }
  ],
  "additionalProperties": false
}
