{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/satroot1.publication-stack-summary.schema.json",
  "title": "SATROOT Publication Stack Summary",
  "type": "object",
  "required": [
    "bundle_scheme",
    "release_scheme",
    "release_catalog_scheme",
    "workspace_count",
    "catalog_workspaces_dir",
    "release_catalog_dir",
    "catalog_preset_paths",
    "release_catalog",
    "release_catalog_manifest_path",
    "workspaces"
  ],
  "properties": {
    "bundle_scheme": {"enum": ["hmac-sha256", "ed25519"]},
    "release_scheme": {"enum": ["hmac-sha256", "ed25519"]},
    "release_catalog_scheme": {"enum": ["hmac-sha256", "ed25519"]},
    "source_catalog_workspace_collection_dir": {"type": ["string", "null"], "minLength": 1},
    "workspace_count": {"type": "integer", "minimum": 1},
    "catalog_workspaces_dir": {"type": "string", "minLength": 1},
    "release_catalog_dir": {"type": "string", "minLength": 1},
    "catalog_preset_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "stack_preset_path": {"type": ["string", "null"], "minLength": 1},
    "release_catalog_preset_path": {"type": ["string", "null"], "minLength": 1},
    "release_catalog": {
      "type": "object",
      "required": ["protocol", "version", "catalog_type", "release_count", "releases"],
      "properties": {
        "protocol": {"const": "SATROOT-1"},
        "version": {"const": "0.1"},
        "catalog_type": {"const": "release-catalog"},
        "release_count": {"type": "integer", "minimum": 1},
        "catalog": {"type": "object"},
        "releases": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "release_catalog_manifest_path": {"type": "string", "minLength": 1},
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workspace_name",
          "preset_path",
          "workspace_dir",
          "summary_path",
          "bundle_count",
          "release_dir",
          "release_manifest_path"
        ],
        "properties": {
          "workspace_name": {"type": "string", "minLength": 1},
          "preset_path": {"type": "string", "minLength": 1},
          "workspace_dir": {"type": "string", "minLength": 1},
          "summary_path": {"type": "string", "minLength": 1},
          "bundle_count": {"type": "integer", "minimum": 1},
          "release_dir": {"type": "string", "minLength": 1},
          "release_manifest_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
